---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Journey from '../components/Journey.astro';
import Chapter from '../components/Chapter.astro';
import Arsenal from '../components/Arsenal.astro';
import Signoff from '../components/Signoff.astro';
import { chapters } from '../data/episode';

const transitions = [
  'So by the end of 2017 you\u2019ve got a r\u00e9sum\u00e9 written in React \u2014 literally, my-react-resume is a real repo. But learning projects are one thing. Getting someone to pay you for code is a different game entirely\u2026',
  'You said the freelance years were really about translating client problems into systems. Your current work is that same instinct, pointed at a much bigger target \u2014 because the biggest \u201cclient\u201d with the most incomprehensible problem right now is basically everyone, trying to figure out AI\u2026',
];
---
<Layout title="Andrew Robida — From Crayons to Code">
  <Header />
  <main id="content" tabindex="-1">
    <Hero />
    <Journey />
    <div id="chapters">
      {chapters.map((ch, i) => (
        <>
          <Chapter chapter={ch} />
          {transitions[i] && (
            <aside class="segue rv">
              <p class="segue-text" data-scrub-text>{transitions[i]}</p>
            </aside>
          )}
        </>
      ))}
    </div>
    <Arsenal />
    <Signoff />
  </main>
</Layout>

<style>
  .segue {
    max-width: 720px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
    text-align: center;
  }
  .segue-text {
    color: var(--sage);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.7;
    font-weight: 500;
  }
  .segue-text::before {
    content: '\201C';
    display: block;
    font-family: var(--display);
    font-size: 3.5rem;
    line-height: 0.5;
    color: var(--lime);
    margin-bottom: 1.2rem;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // split headlines into animatable chars
  document.querySelectorAll<HTMLElement>('[data-split]').forEach((el) => {
    const walk = (node: ChildNode) => {
      if (node.nodeType === Node.TEXT_NODE) {
        const frag = document.createDocumentFragment();
        for (const word of (node.textContent ?? '').split(/(\s+)/)) {
          if (!word.trim()) { frag.appendChild(document.createTextNode(word)); continue; }
          const w = document.createElement('span');
          w.className = 'word';
          for (const ch of word) {
            const c = document.createElement('span');
            c.className = 'char';
            c.textContent = ch;
            w.appendChild(c);
          }
          frag.appendChild(w);
        }
        node.replaceWith(frag);
      } else if (node.nodeType === Node.ELEMENT_NODE && !(node as Element).classList.contains('word')) {
        [...node.childNodes].forEach(walk);
      }
    };
    [...el.childNodes].forEach(walk);
    // stagger
    el.querySelectorAll('.char').forEach((c, i) => {
      (c as HTMLElement).style.transitionDelay = `${Math.min(i * 18, 600)}ms`;
    });
  });

  // intersection reveals
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('in')),
    { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
  );
  document.querySelectorAll('.rv, .split, .cp').forEach((el) => io.observe(el));

  const motion = gsap.matchMedia();
  motion.add('(prefers-reduced-motion: no-preference)', () => {
    document.querySelectorAll<HTMLElement>('[data-scrub-text]').forEach((el) => {
      const words = (el.textContent ?? '').trim().split(/\s+/);
      el.replaceChildren(...words.flatMap((word, index) => {
        const span = document.createElement('span');
        span.className = 'scrub-word';
        span.textContent = word;
        return index === words.length - 1 ? [span] : [span, document.createTextNode(' ')];
      }));
      gsap.fromTo(el.querySelectorAll('.scrub-word'),
        { opacity: 0.1 },
        {
          opacity: 1,
          stagger: 0.08,
          ease: 'none',
          scrollTrigger: { trigger: el, start: 'top 85%', end: 'bottom 45%', scrub: 0.8 },
        }
      );
    });

    const path = document.getElementById('journey-path') as unknown as SVGPathElement | null;
    const track = document.querySelector<HTMLElement>('.track-wrap');
    if (path && track) {
      const length = path.getTotalLength();
      gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });
      gsap.to(path, {
        strokeDashoffset: 0,
        ease: 'none',
        scrollTrigger: { trigger: track, start: 'top 75%', end: 'bottom 35%', scrub: 0.7 },
      });
    }
  });

  motion.add('(min-width: 1001px) and (prefers-reduced-motion: no-preference)', () => {
    const layout = document.querySelector<HTMLElement>('.journey-layout');
    const title = document.querySelector<HTMLElement>('.journey-head');
    if (layout && title) {
      ScrollTrigger.create({
        trigger: layout,
        start: 'top 7rem',
        end: 'bottom 78%',
        pin: title,
        pinSpacing: false,
      });
    }
  });

  document.fonts.ready.then(() => ScrollTrigger.refresh());
</script>
