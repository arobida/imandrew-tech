---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Journey from '../components/Journey.astro';
import Chapter from '../components/Chapter.astro';
import Arsenal from '../components/Arsenal.astro';
import Signoff from '../components/Signoff.astro';
import { chapters } from '../data/episode';

const transitions = [
  'So by the end of 2017 you\u2019ve got a r\u00e9sum\u00e9 written in React. Literally: my-react-resume is a real repo. But learning projects are one thing. Getting someone to pay you for code is a different game entirely\u2026',
  'You said the freelance years were really about translating client problems into systems. Your current work is that same instinct, pointed at a much bigger target: the biggest \u201cclient\u201d with the most incomprehensible problem right now is basically everyone, trying to figure out AI\u2026',
];
---
<Layout title="Andrew Robida - From Crayons to Code">
  <Header />
  <main>
    <Hero />

    <div class="ticker mono" aria-hidden="true">
      <div class="ticker-track">
        {Array(2).fill(0).map(() => (
          <span>
            USMC LOGISTICS &nbsp;&#9642;&nbsp; 60 CONTRACTS / $3M &nbsp;&#9642;&nbsp; GITHUB EST. 2016 &nbsp;&#9642;&nbsp; 200K+ SUBSCRIBER MIGRATION &nbsp;&#9642;&nbsp; 30+ DOMAINS SERVERLESS &nbsp;&#9642;&nbsp; LLMATE &nbsp;&#9642;&nbsp; SWIFT-PASS &nbsp;&#9642;&nbsp; DATA-SMITH &nbsp;&#9642;&nbsp; HELPFUL NOT ADDICTIVE &nbsp;&#9642;&nbsp;
          </span>
        ))}
      </div>
    </div>

    <Journey />
    <div id="chapters">
      {chapters.map((ch, i) => (
        <>
          <Chapter chapter={ch} />
          {transitions[i] && (
            <aside class="segue rv">
              <p class="segue-text">{transitions[i]}</p>
            </aside>
          )}
        </>
      ))}
    </div>
    <Arsenal />
    <Signoff />
  </main>
</Layout>

<style>
  .ticker {
    border-top: 1px solid color-mix(in srgb, var(--sage) 30%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--sage) 30%, transparent);
    padding: 0.9rem 0;
    overflow: hidden;
    white-space: nowrap;
    color: var(--sage);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }
  .ticker-track { display: inline-flex; animation: ticker 40s linear infinite; }
  @keyframes ticker { to { transform: translateX(-50%); } }

  .segue {
    max-width: 720px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
    text-align: center;
  }
  .segue-text {
    color: var(--sage);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.7;
    font-weight: 500;
  }
  .segue-text::before {
    content: '\201C';
    display: block;
    font-family: var(--display);
    font-size: 3.5rem;
    line-height: 0.5;
    color: var(--lime);
    margin-bottom: 1.2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
  }
</style>

<script>
  // split headlines into animatable chars
  document.querySelectorAll<HTMLElement>('[data-split]').forEach((el) => {
    const walk = (node: ChildNode) => {
      if (node.nodeType === Node.TEXT_NODE) {
        const frag = document.createDocumentFragment();
        for (const word of (node.textContent ?? '').split(/(\s+)/)) {
          if (!word.trim()) { frag.appendChild(document.createTextNode(word)); continue; }
          const w = document.createElement('span');
          w.className = 'word';
          for (const ch of word) {
            const c = document.createElement('span');
            c.className = 'char';
            c.textContent = ch;
            w.appendChild(c);
          }
          frag.appendChild(w);
        }
        node.replaceWith(frag);
      } else if (node.nodeType === Node.ELEMENT_NODE && !(node as Element).classList.contains('word')) {
        [...node.childNodes].forEach(walk);
      }
    };
    [...el.childNodes].forEach(walk);
    // stagger
    el.querySelectorAll('.char').forEach((c, i) => {
      (c as HTMLElement).style.transitionDelay = `${Math.min(i * 18, 600)}ms`;
    });
  });

  // intersection reveals
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('in')),
    { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
  );
  document.querySelectorAll('.rv, .split, .cp').forEach((el) => io.observe(el));
</script>
