---
import type { Chapter } from '../data/episode';
interface Props { chapter: Chapter }
const { chapter } = Astro.props;
---
<section class="chapter" id={chapter.id} data-index={chapter.index}>
  <span class="ch-watermark" aria-hidden="true">{chapter.index}</span>
  <div class="ch-head">
    <p class="mono ch-tag rv">
      &#9619; CHAPTER {chapter.index} &middot; {chapter.timecode}
    </p>
    <h2 class="split" data-split>
      <span class="line">{chapter.titleLines[0]}</span>
      <span class="line lime">{chapter.titleLines[1]}</span>
    </h2>
    <blockquote class="ch-lead rv">
      {chapter.leadIn}
    </blockquote>
  </div>

  <ol class="rundown">
    {chapter.questions.map((q, qi) => (
      <li class="q-item rv" data-offset={String(qi % 3)}>
        <button
          class="q-card"
          data-qid={q.id}
          data-cursor="ASK"
          aria-expanded="false"
          aria-controls={`${q.id}-panel`}
        >
          <span class="q-num mono" aria-hidden="true">{chapter.index}.{qi + 1}</span>
          <span class="q-text">
            <span class="q-kind mono">{q.kind}</span>
            {q.q}
          </span>
          <span class="q-state mono" aria-hidden="true">
            <span class="state-ask">+ ASK</span>
            <span class="state-done">&#10003; ANSWERED</span>
          </span>
        </button>

        <div class="q-panel" id={`${q.id}-panel`} hidden>
          <div class="mic mono"><span class="mic-mark">A/</span> ANDREW ANSWERS</div>
          {q.a.map((p) => <p class="a-para">{p}</p>)}
          {q.stats && (
            <ul class="a-stats mono">
              {q.stats.map((s) => <li>{s}</li>)}
            </ul>
          )}
          {q.followUps && (
            <div class="followups">
              <p class="mono fu-tag">&#9619; DIG DEEPER</p>
              {q.followUps.map((fu, fui) => (
                <div class="fu">
                  <button
                    class="fu-btn mono"
                    data-fu={`${q.id}-fu${fui}`}
                    aria-expanded="false"
                    aria-controls={`${q.id}-fu${fui}`}
                  >
                    &gt; {fu.q}
                  </button>
                  <div class="fu-panel" id={`${q.id}-fu${fui}`} hidden>
                    <p class="a-para">{fu.a}</p>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </li>
    ))}
  </ol>

  <div class="takeaway rv">
    <span class="mono tw-label">THE POINT &middot; {chapter.index}</span>
    <p>{chapter.takeaway}</p>
  </div>
</section>

<style>
  .chapter {
    position: relative;
    padding: 7rem 1.5rem 5rem;
    border-top: 1px solid color-mix(in srgb, var(--dim) 25%, transparent);
    overflow: hidden;
  }
  .chapter:nth-of-type(even) { background: var(--crt-hi); }
  .ch-watermark {
    position: absolute;
    top: 1.5rem;
    right: -1rem;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(14rem, 30vw, 26rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--dim) 22%, transparent);
    pointer-events: none;
    user-select: none;
  }
  .ch-head {
    position: relative;
    max-width: 1100px;
    margin: 0 auto 3.5rem;
  }
  .ch-tag { color: var(--hazard); font-size: 0.72rem; letter-spacing: 0.12em; margin-bottom: 1.2rem; }
  .ch-head h2 { font-size: clamp(2.4rem, 6vw, 5rem); margin-bottom: 1.8rem; }
  .ch-head h2 .line { display: block; }
  .ch-lead {
    max-width: 640px;
    color: var(--dim);
    font-size: 1.05rem;
    line-height: 1.7;
    border-left: 2px solid var(--hazard);
    padding-left: 1.4rem;
  }

  .rundown {
    position: relative;
    list-style: none;
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .q-card {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: 90px 1fr auto;
    gap: 1.5rem;
    align-items: start;
    text-align: left;
    background: transparent;
    color: var(--phosphor);
    border: 1px solid color-mix(in srgb, var(--dim) 35%, transparent);
    padding: 1.4rem 1.6rem;
    cursor: pointer;
    font-family: var(--body);
    font-size: 1rem;
    overflow: hidden;
    transition: border-color 0.25s;
  }
  /* diagonal wipe fill on hover */
  .q-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--hazard);
    opacity: 0.07;
    clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%);
    transition: clip-path 0.35s var(--ease-pop);
    pointer-events: none;
  }
  .q-card:hover::before { clip-path: polygon(0 0%, 100% -12%, 100% 100%, 0 100%); }
  .q-card:hover { border-color: var(--hazard); }

  .q-num {
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--dim) 70%, transparent);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.1;
    transition: color 0.25s, -webkit-text-stroke-color 0.25s;
  }
  .q-card:hover .q-num, .q-item.asked .q-num {
    color: var(--hazard);
    -webkit-text-stroke-color: var(--hazard);
  }
  .q-kind {
    display: inline-block;
    color: var(--void); background: var(--dim);
    font-size: 0.58rem; font-weight: 600; letter-spacing: 0.12em;
    padding: 0.15rem 0.5rem;
    margin-bottom: 0.45rem;
  }
  .q-text { line-height: 1.55; display: block; }
  .q-state { font-size: 0.7rem; letter-spacing: 0.08em; white-space: nowrap; padding-top: 0.2rem; }
  .state-ask { color: var(--hazard); }
  .state-done { color: var(--dim); display: none; }
  .q-item.asked .q-card { border-color: color-mix(in srgb, var(--hazard) 60%, transparent); }
  .q-item.asked .state-ask { display: none; }
  /* inline-block so the GSAP slide-in transform can render on it */
  .q-item.asked .state-done { display: inline-block; color: var(--hazard); }

  /* Panels open/close via GSAP clip-path tweens; hidden attribute is the
     no-JS / reduced-motion fallback state. */
  .q-panel {
    border: 1px solid color-mix(in srgb, var(--hazard) 45%, transparent);
    border-top: none;
    background: var(--void);
    padding: 1.8rem 1.6rem 1.6rem;
  }
  .mic {
    display: flex; align-items: center; gap: 0.6rem;
    color: var(--hazard); font-size: 0.68rem; letter-spacing: 0.14em;
    margin-bottom: 1.2rem;
  }
  .mic-mark {
    font-weight: 600;
    background: var(--hazard);
    color: var(--void);
    padding: 0.15rem 0.4rem;
  }
  .a-para {
    color: var(--phosphor);
    max-width: 68ch;
    margin-bottom: 1.1rem;
    line-height: 1.75;
  }
  .a-stats {
    list-style: none;
    display: flex; flex-wrap: wrap; gap: 0.6rem;
    margin: 0.4rem 0 0.8rem;
  }
  .a-stats li {
    color: var(--void); background: var(--hazard);
    font-size: 0.66rem; font-weight: 600; letter-spacing: 0.08em;
    padding: 0.35rem 0.7rem;
  }
  .followups { margin-top: 1.4rem; border-top: 1px dashed color-mix(in srgb, var(--dim) 40%, transparent); padding-top: 1.2rem; }
  .fu-tag { color: var(--dim); font-size: 0.66rem; letter-spacing: 0.12em; margin-bottom: 0.9rem; }
  .fu { margin-bottom: 0.7rem; }
  .fu-btn {
    background: none;
    border: 1px solid color-mix(in srgb, var(--dim) 45%, transparent);
    color: var(--dim);
    font-size: 0.78rem;
    text-align: left;
    padding: 0.7rem 1rem;
    cursor: pointer;
    width: 100%;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
    line-height: 1.5;
  }
  .fu-btn:hover { color: var(--hazard); border-color: var(--hazard); background: color-mix(in srgb, var(--hazard) 5%, transparent); }
  .fu-panel { padding: 1rem 0.4rem 0.2rem; }
  .fu-panel .a-para { color: var(--dim); font-size: 0.95rem; }

  .takeaway {
    max-width: 1100px;
    margin: 4.5rem auto 0;
    background: var(--hazard);
    color: var(--void);
    padding: 2.2rem 2.4rem;
  }
  .tw-label { font-size: 0.66rem; font-weight: 600; letter-spacing: 0.16em; display: block; margin-bottom: 0.8rem; }
  .takeaway p {
    font-family: var(--display);
    text-transform: uppercase;
    font-weight: 600;
    font-size: clamp(1.3rem, 3vw, 2.1rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  @media (max-width: 760px) {
    .ch-watermark { font-size: 12rem; top: 0.5rem; right: -2rem; }
    .q-card { grid-template-columns: 1fr; gap: 0.8rem; }
    .q-num { font-size: 1.1rem; }
    .q-state { justify-self: start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .q-card::before { transition: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const asked = new Set<string>();
  const totalQ = 11;
  const countEl = document.getElementById('asked-count');
  const fillEl = document.getElementById('ep-progress');
  const barEl = document.getElementById('ep-progress-bar');
  const bump = (id: string) => {
    if (asked.has(id)) return;
    asked.add(id);
    if (countEl) {
      countEl.textContent = String(asked.size).padStart(2, '0');
      if (!reduceMotion) {
        gsap.fromTo(countEl, { scale: 1.4 }, { scale: 1, duration: 0.45, ease: 'back.out(2.5)', overwrite: 'auto' });
      }
    }
    if (fillEl) {
      const width = `${(asked.size / totalQ) * 100}%`;
      // no CSS transition on width: GSAP tweens it here, reduced motion swaps instantly
      if (reduceMotion) fillEl.style.width = width;
      else gsap.to(fillEl, { width, duration: 0.6, ease: 'expo.out', overwrite: 'auto' });
    }
    if (barEl) barEl.setAttribute('aria-valuenow', String(asked.size));
    if (asked.size === totalQ) {
      document.dispatchEvent(new CustomEvent('episode-complete'));
    }
  };

  const finePointer = window.matchMedia('(pointer: fine)').matches;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const CLIP_CLOSED = 'polygon(0 0, 100% 0, 100% 0, 0 0)';
  const CLIP_OPEN = 'polygon(0 0, 100% 0, 100% 100%, 0 100%)';

  document.querySelectorAll<HTMLButtonElement>('.q-card').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.qid!;
      const panel = document.getElementById(`${id}-panel`)!;
      const item = btn.closest('.q-item')!;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        btn.setAttribute('aria-expanded', 'false');
        if (reduceMotion) {
          panel.hidden = true;
        } else {
          gsap.to(panel, {
            clipPath: CLIP_CLOSED,
            duration: 0.35,
            ease: 'power3.inOut',
            overwrite: 'auto',
            onComplete: () => { panel.hidden = true; },
          });
        }
      } else {
        btn.setAttribute('aria-expanded', 'true');
        panel.hidden = false;
        const firstAsk = !item.classList.contains('asked');
        item.classList.add('asked');
        bump(id);
        if (!reduceMotion) {
          // first open: slide "✓ ANSWERED" in instead of hard-cutting to it
          if (firstAsk) {
            const done = btn.querySelector('.state-done');
            if (done) {
              gsap.fromTo(done,
                { y: 10, autoAlpha: 0 },
                { y: 0, autoAlpha: 1, duration: 0.45, ease: 'back.out(2)', delay: 0.18, clearProps: 'all' });
            }
          }
          gsap.fromTo(panel,
            { clipPath: CLIP_CLOSED },
            { clipPath: CLIP_OPEN, duration: 0.5, ease: 'power3.out', overwrite: 'auto' });
          gsap.fromTo(panel.querySelectorAll('.a-para, .a-stats, .followups'),
            { y: 12, autoAlpha: 0 },
            { y: 0, autoAlpha: 1, duration: 0.45, stagger: 0.07, delay: 0.12, overwrite: 'auto', clearProps: 'all' });
        }
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.fu-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = document.getElementById(btn.dataset.fu!)!;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isOpen));
      if (isOpen) {
        panel.hidden = true;
        return;
      }
      panel.hidden = false;
      if (!reduceMotion) {
        gsap.fromTo(panel.querySelector('.a-para'),
          { y: 10, autoAlpha: 0 },
          { y: 0, autoAlpha: 1, duration: 0.4, clearProps: 'all' });
      }
    });
  });

  // Cursor label: quickSetter keeps the label locked to the pointer while GSAP
  // handles its enter/leave motion, shown on [data-cursor] hover.
  // Pointer-fine devices only; skipped entirely under reduced motion.
  if (finePointer && !reduceMotion && !document.getElementById('cursor-label')) {
    const el = document.createElement('div');
    el.id = 'cursor-label';
    el.setAttribute('aria-hidden', 'true');
    document.body.appendChild(el);
    const style = document.createElement('style');
    style.textContent = `
      #cursor-label {
        position: fixed; top: 0; left: 0; z-index: 200;
        padding: 0.45rem 0.8rem;
        font-family: var(--mono); font-size: 0.62rem; font-weight: 600; letter-spacing: 0.14em;
        color: var(--void); background: color-mix(in srgb, var(--hazard) 85%, transparent);
        backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
        pointer-events: none;
        white-space: nowrap;
        opacity: 0; visibility: hidden;
        will-change: transform, opacity;
      }
    `;
    document.head.appendChild(style);

    gsap.set(el, { xPercent: -50, yPercent: -50, scale: 0.8 });
    const setX = gsap.quickSetter(el, 'x', 'px');
    const setY = gsap.quickSetter(el, 'y', 'px');
    window.addEventListener('pointermove', (e) => { setX(e.clientX); setY(e.clientY); }, { passive: true });

    document.querySelectorAll<HTMLElement>('[data-cursor]').forEach((t) => {
      t.addEventListener('pointerenter', (e) => {
        setX(e.clientX);
        setY(e.clientY);
        el.textContent = `${t.dataset.cursor} →`;
        gsap.to(el, { autoAlpha: 1, yPercent: -130, scale: 1, duration: 0.25, ease: 'power3.out', overwrite: 'auto' });
      });
      t.addEventListener('pointerleave', () => {
        gsap.to(el, { autoAlpha: 0, yPercent: -50, scale: 0.8, duration: 0.2, overwrite: 'auto' });
      });
    });
  }
</script>
