---
import { projects } from '../data/episode';
---
<section class="arsenal" id="arsenal">
  <div class="ar-head">
    <p class="mono ar-tag rv">&#9619; CURRENT WORK &mdash; SHIPPING NOW</p>
    <h2 class="split" data-split>THE ARSENAL</h2>
    <p class="ar-sub rv">
      Every claim above has a repo behind it. Pull any of them down and break something &mdash;
      he builds in public, so he can take it.
    </p>
  </div>

  <div class="ar-grid">
    {projects.map((p) => (
      <a class="ar-card rv" href={p.url} target="_blank" rel="noopener">
        <p class="ar-cmd mono">{p.cmd}<span class="blink">_</span></p>
        <h3>{p.name}</h3>
        <p class="ar-desc">{p.desc}</p>
        <p class="ar-meta mono">{p.meta}</p>
      </a>
    ))}
  </div>
</section>

<style>
  .arsenal {
    background: var(--ink);
    border-top: 1px solid color-mix(in srgb, var(--sage) 25%, transparent);
    padding: 7rem 1.5rem;
  }
  .ar-head { max-width: 1100px; margin: 0 auto 4rem; }
  .ar-tag { color: var(--lime); font-size: 0.72rem; letter-spacing: 0.12em; margin-bottom: 1.2rem; }
  .ar-head h2 { font-size: clamp(2.6rem, 6.5vw, 5.5rem); margin-bottom: 1.4rem; }
  .ar-sub { color: var(--sage); max-width: 520px; }

  .ar-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }
  .ar-card {
    display: flex;
    flex-direction: column;
    border: 1px solid color-mix(in srgb, var(--sage) 35%, transparent);
    padding: 1.8rem 1.6rem;
    text-decoration: none;
    color: var(--paper);
    transition: border-color 0.25s, transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ar-card:hover {
    border-color: var(--lime);
    transform: translateY(-6px);
  }
  .ar-cmd {
    color: var(--lime);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    margin-bottom: 1.6rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ar-card h3 { font-size: 1.9rem; margin-bottom: 0.8rem; }
  .ar-desc { color: var(--sage); font-size: 0.92rem; line-height: 1.7; flex: 1; }
  .ar-meta {
    color: var(--sage);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    margin-top: 1.6rem;
    border-top: 1px solid color-mix(in srgb, var(--sage) 30%, transparent);
    padding-top: 1rem;
  }
  @media (max-width: 900px) { .ar-grid { grid-template-columns: 1fr; } }
</style>
