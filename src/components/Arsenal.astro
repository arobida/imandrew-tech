---
import { projects } from '../data/episode';
---
<section class="arsenal" id="arsenal">
  <div class="ar-head">
    <p class="mono ar-tag rv">&#9619; CURRENT WORK &mdash; SHIPPING NOW</p>
    <h2 class="split" data-split>THE ARSENAL</h2>
    <p class="ar-sub rv">
      Every claim above has a repo behind it. Pull any of them down and break something &mdash;
      he builds in public, so he can take it.
    </p>
  </div>

  <div class="ar-accordion">
    {projects.map((p) => (
      <a class="ar-card rv" href={p.url} target="_blank" rel="noopener">
        <img src={`https://picsum.photos/seed/${p.name}-system/1200/900`} alt="" width="1200" height="900" loading="lazy" />
        <span class="ar-shade" aria-hidden="true"></span>
        <div class="ar-content">
          <p class="ar-cmd mono">{p.cmd}<span class="blink">_</span></p>
          <h3>{p.name}</h3>
          <p class="ar-desc">{p.desc}</p>
          <p class="ar-meta mono">{p.meta}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .arsenal {
    background: var(--ink);
    border-top: 1px solid color-mix(in srgb, var(--sage) 25%, transparent);
    padding: 10rem 1.5rem;
  }
  .ar-head { max-width: 1400px; margin: 0 auto 4rem; }
  .ar-tag { color: var(--lime); font-size: 0.72rem; letter-spacing: 0.12em; margin-bottom: 1.2rem; }
  .ar-head h2 { font-size: clamp(2.6rem, 6.5vw, 5.5rem); margin-bottom: 1.4rem; }
  .ar-sub { color: var(--sage); max-width: 520px; }

  .ar-accordion {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    min-height: 36rem;
    gap: 0.45rem;
  }
  .ar-card {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--paper);
    overflow: hidden;
    border-radius: 0.25rem;
    isolation: isolate;
    transition: flex 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.25s ease;
  }
  .ar-card:hover, .ar-card:focus-visible {
    flex: 1.8 1 0;
    transform: translateY(-0.35rem);
  }
  .ar-card:active { transform: translateY(0) scale(0.99); }
  .ar-card img {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1) contrast(1.25);
    opacity: 0.78;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1), filter 0.7s ease, opacity 0.7s ease;
  }
  .ar-card:hover img, .ar-card:focus-visible img { transform: scale(1.05); filter: grayscale(0.15) contrast(1.15); opacity: 0.95; }
  .ar-shade {
    position: absolute; inset: 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--ink) 96%, transparent) 0%, color-mix(in srgb, var(--ink) 35%, transparent) 70%, transparent 100%);
    z-index: 1;
  }
  .ar-content { position: relative; z-index: 2; margin-top: auto; padding: 2rem; }
  .ar-cmd {
    color: var(--lime);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    margin-bottom: 1.4rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ar-card h3 { font-size: clamp(2rem, 3.5vw, 3.8rem); margin-bottom: 0.8rem; }
  .ar-desc { color: var(--paper); font-size: 0.92rem; line-height: 1.7; max-width: 52ch; opacity: 0.78; }
  .ar-meta {
    color: var(--sage);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    margin-top: 1.6rem;
    border-top: 1px solid color-mix(in srgb, var(--sage) 30%, transparent);
    padding-top: 1rem;
  }
  @media (max-width: 900px) {
    .arsenal { padding-block: 7rem; }
    .ar-accordion { display: grid; min-height: 0; }
    .ar-card { min-height: 27rem; }
    .ar-card:hover, .ar-card:focus-visible { transform: none; }
  }
</style>
