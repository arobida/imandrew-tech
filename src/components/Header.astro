---
const total = 11;
---
<header class="site-head" id="site-head">
  <a href="#top" class="brand mono">
    <span class="brand-mark"></span>
    <span>ANDREW ROBIDA</span>
  </a>
  <nav class="head-nav mono">
    <a href="#journey">STORY</a>
    <a href="#chapters">ASK</a>
    <a href="#arsenal">WORK</a>
    <a href="#signoff">CONNECT</a>
  </nav>
  <div class="progress-wrap mono" title="Prompts explored">
    <span class="progress-label">EXPLORED</span>
    <div class="progress-track"><div class="progress-fill" id="ep-progress"></div></div>
    <span class="progress-count"><span id="asked-count">00</span>/{total}</span>
  </div>
</header>

<style>
  .site-head {
    position: fixed;
    top: 1rem; left: 50%;
    z-index: 100;
    width: min(calc(100% - 2rem), 88rem);
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 0.75rem 0.85rem 0.75rem 1rem;
    background: color-mix(in srgb, var(--olive-deep) 76%, transparent);
    backdrop-filter: blur(18px) saturate(130%);
    -webkit-backdrop-filter: blur(18px) saturate(130%);
    border: 1px solid color-mix(in srgb, var(--paper) 16%, transparent);
    border-radius: 0.7rem;
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 10%, transparent), 0 1rem 4rem color-mix(in srgb, var(--olive-deep) 55%, transparent);
    transform: translateX(-50%);
    transition: transform 0.45s var(--ease-pop);
  }
  .site-head.hidden-head { transform: translate(-50%, calc(-100% - 1.5rem)); }
  .brand {
    display: flex; align-items: center; gap: 0.6rem;
    color: var(--paper); text-decoration: none;
    font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em;
  }
  .brand-mark {
    width: 12px; height: 12px;
    background: var(--lime);
    clip-path: polygon(0 0, 100% 0, 100% 65%, 65% 100%, 0 100%);
  }
  .head-nav { display: flex; gap: 1.4rem; margin-left: auto; }
  .head-nav a {
    color: var(--sage); text-decoration: none;
    font-size: 0.72rem; letter-spacing: 0.06em;
    padding: 0.5rem 0.2rem;
    transition: color 0.2s, transform 0.2s;
  }
  .head-nav a:hover { color: var(--lime); transform: translateY(-1px); }
  .progress-wrap {
    display: flex; align-items: center; gap: 0.6rem;
    border-left: 1px solid color-mix(in srgb, var(--sage) 30%, transparent);
    padding-left: 1.5rem;
  }
  .progress-label { font-size: 0.6rem; color: var(--sage); letter-spacing: 0.1em; }
  .progress-track {
    width: 72px; height: 5px;
    background: color-mix(in srgb, var(--sage) 25%, transparent);
    overflow: hidden;
  }
  .progress-fill {
    height: 100%; width: 0%;
    background: var(--lime);
    transition: width 0.5s var(--ease-pop);
  }
  .progress-count { font-size: 0.7rem; color: var(--lime); min-width: 4.2ch; }
  @media (max-width: 760px) {
    .site-head { top: 0.65rem; width: calc(100% - 1.3rem); }
    .head-nav { display: none; }
    .progress-wrap { margin-left: auto; }
    .progress-label, .progress-track { display: none; }
  }
</style>

<script>
  const head = document.getElementById('site-head');
  let lastY = window.scrollY;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (head) {
      if (y > lastY && y > 300) head.classList.add('hidden-head');
      else head.classList.remove('hidden-head');
    }
    lastY = y;
  }, { passive: true });
</script>
