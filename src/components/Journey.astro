---
import { journey } from '../data/episode';
---
<section class="journey" id="journey">
  <div class="journey-layout">
    <div class="journey-head">
      <p class="mono sec-tag rv">&#9619; THE ROUTE IN &mdash; 2004 &rarr; NOW</p>
      <h2 class="split" data-split>TWELVE YEARS TO<br /><span class="lime">FIRST COMMIT</span></h2>
      <p class="journey-sub rv">
        Twenty years, one through-line. Follow the wire &mdash;
        it draws itself as you scroll, checkpoint by checkpoint.
      </p>
    </div>

    <div class="track-wrap">
      <svg class="track-line" viewBox="0 0 100 2000" preserveAspectRatio="none" aria-hidden="true">
        <path
          id="journey-path"
          d="M50,0 C20,150 80,300 50,450 C20,600 80,750 50,900 C20,1050 80,1200 50,1350 C20,1500 80,1650 50,1800 L50,2000"
          fill="none"
          stroke="#d2ff00"
          stroke-width="3"
          vector-effect="non-scaling-stroke"
        />
      </svg>
      <ol class="track">
        {journey.map((cp, i) => (
          <li class={`cp ${i % 2 ? 'right' : 'left'} rv`}>
            <div class="cp-node" aria-hidden="true"><span class="cp-dot"></span></div>
            <div class="cp-card">
              <div class="cp-meta mono">
                <span class="cp-year">{cp.year}</span>
                <span class="cp-tag">{cp.tag}</span>
              </div>
              <h3>{cp.title}</h3>
              <p>{cp.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .journey {
    background: var(--olive-deep);
    border-top: 1px solid color-mix(in srgb, var(--sage) 25%, transparent);
    padding: 9rem 1.5rem 10rem;
  }
  .journey-layout {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(18rem, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(4rem, 8vw, 9rem);
    align-items: start;
  }
  .journey-head {
    padding-top: 1rem;
  }
  .sec-tag { color: var(--lime); font-size: 0.72rem; letter-spacing: 0.12em; margin-bottom: 1.2rem; }
  .journey-head h2 { font-size: clamp(2.6rem, 6.5vw, 5.5rem); margin-bottom: 1.4rem; }
  .journey-sub { color: var(--sage); max-width: 480px; }

  .track-wrap { position: relative; min-width: 0; }
  .track-line {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
  }
  .track {
    position: relative;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }
  .cp {
    position: relative;
    width: 50%;
  }
  .cp.left { align-self: flex-start; padding-right: 3.5rem; text-align: right; }
  .cp.right { align-self: flex-end; padding-left: 3.5rem; }
  .cp-node {
    position: absolute;
    top: 1.1rem;
    width: 14px; height: 14px;
  }
  .cp.left .cp-node { right: -7px; }
  .cp.right .cp-node { left: -7px; }
  .cp-dot {
    display: block;
    width: 14px; height: 14px;
    background: var(--olive-deep);
    border: 2px solid var(--lime);
    border-radius: 50%;
    transition: background 0.3s, box-shadow 0.3s;
  }
  .cp.in .cp-dot { background: var(--lime); box-shadow: 0 0 14px color-mix(in srgb, var(--lime) 60%, transparent); }
  .cp-meta {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }
  .cp.left .cp-meta { justify-content: flex-end; }
  .cp-year { color: var(--lime); font-weight: 600; font-size: 0.85rem; letter-spacing: 0.06em; }
  .cp-tag {
    color: var(--ink); background: var(--sage);
    font-size: 0.6rem; font-weight: 600; letter-spacing: 0.1em;
    padding: 0.15rem 0.5rem;
  }
  .cp h3 { font-size: clamp(1.4rem, 2.6vw, 2rem); margin-bottom: 0.6rem; }
  .cp p { color: var(--sage); font-size: 0.95rem; }

  @media (max-width: 1000px) {
    .journey { padding-block: 7rem; }
    .journey-layout { display: block; }
    .journey-head { margin-bottom: 5rem; }
    .track-line { left: 7px; width: calc(100% - 7px); }
    .cp, .cp.left, .cp.right {
      width: 100%;
      align-self: stretch;
      text-align: left;
      padding: 0 0 0 2.6rem;
    }
    .cp.left .cp-node, .cp.right .cp-node { left: 0; right: auto; }
    .cp.left .cp-meta { justify-content: flex-start; }
  }
</style>
